#!/usr/bin/env bash
# Cross-platform pbcopy wrapper supporting OSC 52 clipboard forwarding over SSH
# and native clipboard fallback on macOS/Linux.

_osc52() {
  local b64
  b64="$(base64 | tr -d '\n')"
  if [ -w /dev/tty ]; then
    printf '\033]52;c;%s\a' "$b64" > /dev/tty
  else
    printf '\033]52;c;%s\a' "$b64"
  fi
}

if [ -n "${SSH_CONNECTION:-}" ] || [ -n "${SSH_TTY:-}" ]; then
  _osc52
elif [ -x /usr/bin/pbcopy ]; then
  /usr/bin/pbcopy "$@"
elif command -v wl-copy >/dev/null 2>&1; then
  wl-copy "$@"
elif command -v xclip >/dev/null 2>&1; then
  xclip -selection clipboard "$@"
else
  _osc52
fi
